# 複製這個檔案為 .env，並填入自己的值
# cp .env.example .env

# 伺服器監聽的 port
PORT=3000

# 資料庫欄位加密金鑰，AES-256-CBC 用，必須「剛好 32 個字元」
# 產生方式：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=請替換成剛好32個字元的亂數字串

# Express session 的簽章密鑰，建議用長亂數字串
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=請替換成隨機字串

# 正式環境部署在 HTTPS 之後，設為 true 讓 cookie 只在 HTTPS 傳送
COOKIE_SECURE=false

# 系統初始化時建立的預設管理員帳號密碼（僅在 users 資料表是空的時候會用到）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456

# SQLite 資料庫檔案路徑，一般不用設定；測試套件會用這個變數指向暫存資料庫
# DB_PATH=./atelier.db

# 部署在反向代理（Nginx、Render、Railway、Heroku 等）後面時才需要設定，
# 用來告訴 Express 要信任幾層代理加上的 X-Forwarded-For，通常設 1 即可。
# 本機直接執行、沒有反向代理的話請留空，不要設定這個變數。
# TRUST_PROXY=1
